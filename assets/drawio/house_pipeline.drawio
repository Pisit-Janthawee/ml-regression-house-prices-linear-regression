<mxfile host="app.diagrams.net" pages="1"><diagram name="House Prices: from one feature to a regularised blend" id="house_pipeline"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="720" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="House Prices: from one feature to a regularised blend" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Target and features (inside each CV fold)" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="800" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Models, from simple to blended" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="820" height="36" as="geometry"/></mxCell><mxCell id="n3" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="800" height="580" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Let the formula decide each transform&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="800" height="30" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;No leakage&lt;/b&gt;&lt;br&gt;every fitted step lives in a scikit-learn pipeline, refit per fold" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="780" height="70" as="geometry"/></mxCell><mxCell id="n6" value="1,460 houses&lt;br&gt;79 features" style="fontFamily=Helvetica;fontColor=#000000;shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="45" y="218" width="110" height="64" as="geometry"/></mxCell><mxCell id="n7" value="log(SalePrice)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="195" y="148" width="110" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Encode + log1p&lt;br&gt;+ TotalSF" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="185" y="288" width="130" height="64" as="geometry"/></mxCell><mxCell id="n9" value="pipeline&lt;br&gt;5-fold CV" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="395" y="202" width="130" height="96" as="geometry"/></mxCell><mxCell id="n10" value="RMSE" style="fontFamily=Helvetica;fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="616" y="216" width="68" height="68" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="log RMSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Target + feature steps&lt;/b&gt;&lt;br&gt;log price: errors become % errors&lt;br&gt;Ex ... Po -&gt; 5 ... 1, absent = 0&lt;br&gt;one-hot, rare (&lt; 10) merged&lt;br&gt;log1p if |skew| &gt; 0.75 (31 cols)&lt;br&gt;TotalSF: correlation 0.83" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Outliers&lt;/b&gt;&lt;br&gt;z-score trimming re-tested:&lt;br&gt;removes the top of the market&lt;br&gt;-&gt; left alone (CV 0.112)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="260" height="110" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n9" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="820" height="580" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Penalties tame 249 columns&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="115" width="820" height="30" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Final model&lt;/b&gt;&lt;br&gt;Lasso + LightGBM average: CV RMSE 0.109 (11.6 % typical miss)" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="610" width="800" height="70" as="geometry"/></mxCell><mxCell id="n23" value="Plain MLR&lt;br&gt;0.208" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="905" y="138" width="110" height="64" as="geometry"/></mxCell><mxCell id="n24" value="Ridge&lt;br&gt;0.113" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="905" y="228" width="110" height="64" as="geometry"/></mxCell><mxCell id="n25" value="Lasso&lt;br&gt;0.112" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="318" width="110" height="64" as="geometry"/></mxCell><mxCell id="n26" value="LightGBM&lt;br&gt;0.116" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="408" width="110" height="64" as="geometry"/></mxCell><mxCell id="n27" value="average&lt;br&gt;Lasso + LGBM" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1125" y="347" width="150" height="96" as="geometry"/></mxCell><mxCell id="n28" value="price" style="fontFamily=Helvetica;fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1356" y="361" width="68" height="68" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="exp()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Why plain MLR fails&lt;/b&gt;&lt;br&gt;fine on 4 folds, one fold 0.54:&lt;br&gt;one house predicted at $188 M" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="178" width="260" height="74" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n23" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Penalty alpha (tuned by CV)&lt;/b&gt;&lt;br&gt;Ridge alpha ~ 14.7 shrinks all&lt;br&gt;Lasso alpha ~ 0.00056 zeroes some&lt;br&gt;keeps 100 of 249 columns" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="250" width="260" height="110" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n24" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Why blend&lt;/b&gt;&lt;br&gt;linear model: smooth trends&lt;br&gt;trees: thresholds and interactions&lt;br&gt;errors differ -&gt; average is better" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="300" height="100" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n27" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>